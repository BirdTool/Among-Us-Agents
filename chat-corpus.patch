diff --git a/AMG/AI/Services/ChatService/Corpus/ChatCorpus.cs b/AMG/AI/Services/ChatService/Corpus/ChatCorpus.cs
new file mode 100644
index 0000000..2c90a92
--- /dev/null
+++ b/AMG/AI/Services/ChatService/Corpus/ChatCorpus.cs
@@ -0,0 +1,185 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using AMG.AI.Services.ChatService.History;
+using AMG.Utilities;
+using UnityEngine;
+
+namespace AMG.AI.Services.ChatService.Corpus
+{
+    /// <summary>
+    /// Passive collector of what real players say. It only OBSERVES: nothing here sends chat, touches the bank or
+    /// influences an agent. Output (Among Us_Data/AMG/Corpus/):
+    ///   UnknownMessages.jsonl : messages the parser did not understand (or understood with low confidence) -> to be reviewed
+    ///   ChatCorpus.jsonl      : understood messages (to audit the parser), meeting headers, and counts of dropped messages
+    ///   ChatBlocklist.txt     : words that make a message be dropped (never stored); extend it
+    ///
+    /// Privacy: no names, no account ids. Players inside the text become {player}, rooms {room}; speakers are per-meeting
+    /// pseudonyms. Links, handles, e-mails and numbers drop the whole message. Nothing here ever judges a player.
+    /// </summary>
+    public static class ChatCorpus
+    {
+        private const float UnderstoodMin = 0.6f;
+        private const int PrevKept = 3;
+
+        private static readonly string Session = Guid.NewGuid().ToString("N")[..6];
+        private static readonly object FileLock = new();
+
+        private static bool _enabled = true;
+        private static int _meeting;
+        private static float _meetingStartedAt;
+        private static readonly Dictionary<byte, string> _speakers = [];
+        private static readonly List<CorpusPrev> _prev = [];
+        private static readonly List<(string type, float time)> _tape = [];
+        private static ChatSafetyFilter _filter;
+
+        private static string CorpusFile => ModPaths.Data("Corpus", "ChatCorpus.jsonl");
+        private static string UnknownFile => ModPaths.Data("Corpus", "UnknownMessages.jsonl");
+        private static string BlocklistFile => ModPaths.Data("Corpus", "ChatBlocklist.txt");
+
+        public static bool Enabled => _enabled;
+
+        public static void Toggle()
+        {
+            _enabled = !_enabled;
+            LogManager.LogDebug($"[Corpus] capture {(_enabled ? "ON" : "OFF")}");
+        }
+
+        /// <summary>The player saw something the mod cannot detect by itself (a phantom vanishing...): remember it for the next meeting.</summary>
+        public static void Mark(string type)
+        {
+            _tape.Add((type, Time.time));
+            LogManager.LogDebug($"[Corpus] marked '{type}' ({_tape.Count} event(s) this round)");
+        }
+
+        /// <summary>MeetingHud.Start: new meeting, new pseudonyms; the events marked during the round are attached to it.</summary>
+        public static void OnMeetingStart()
+        {
+            _meeting++;
+            _meetingStartedAt = Time.time;
+            _speakers.Clear();
+            _prev.Clear();
+
+            var header = new CorpusMeeting
+            {
+                Session = Session,
+                Meeting = _meeting,
+                Utc = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"),
+                Alive = Utils.Players.AllPlayers.Count(p => p != null && p.Data != null && !p.Data.IsDead),
+                Events = _tape.Select(e => new CorpusEvent { Type = e.type, SecBefore = Round1(Time.time - e.time) }).ToList(),
+            };
+            _tape.Clear();
+
+            if (_enabled) Append(CorpusFile, CorpusJson.Line(header));
+        }
+
+        /// <summary>
+        /// Stores one message said by a real player and returns the version that is safe to show in logs
+        /// (masked text, or "[dropped:category]"). The raw text never leaves this method.
+        /// </summary>
+        public static string Record(PlayerControl sender, string raw, MessageParsedData parsed)
+        {
+            string speaker = Speaker(sender);
+            var verdict = Filter.Check(raw);
+            bool contact = ChatRedactor.HasContactInfo(raw);
+
+            if (contact || verdict.Drop)
+            {
+                string category = contact ? "contact" : verdict.Category;
+
+                // only the fact that something was dropped is kept, never its text
+                if (_enabled)
+                {
+                    Append(CorpusFile, CorpusJson.Line(new CorpusMessage
+                    {
+                        Session = Session, Meeting = _meeting, At = Round1(Time.time - _meetingStartedAt),
+                        Speaker = speaker, Bucket = "filtered", Category = category,
+                    }));
+                }
+
+                return $"[dropped:{category}]";
+            }
+
+            var players = ChatParser.SnapshotPlayers(out var rooms);
+            string masked = ChatParser.MaskEntities(raw, players, rooms);
+            if (masked.Length == 0) return "";
+
+            bool understood = parsed.Intent != null && parsed.Confidence >= UnderstoodMin;
+            string bucket = parsed.Intent == null ? "unknown" : understood ? "understood" : "low";
+
+            var open = ClaimStore.OpenQuestionPhraseIds();
+            var record = new CorpusMessage
+            {
+                Session = Session,
+                Meeting = _meeting,
+                At = Round1(Time.time - _meetingStartedAt),
+                Speaker = speaker,
+                Text = masked,
+                Bucket = bucket,
+                Flag = verdict.Category,   // "profanity": kept, but flagged for the reviewer
+                Reason = parsed.Rationale,
+                Parse = parsed.Intent == null ? null : new CorpusParse
+                {
+                    Id = parsed.Intent.PhraseId,
+                    Intent = parsed.Intent.Type.ToString(),
+                    Room = parsed.Intent.Room?.ToString(),
+                    Confidence = (float)Math.Round(parsed.Confidence, 2),
+                },
+                Prev = _prev.Count > 0 ? _prev.ToList() : null,
+                Open = open.Count > 0 ? open : null,
+            };
+
+            if (_enabled) Append(understood ? CorpusFile : UnknownFile, CorpusJson.Line(record));
+
+            _prev.Add(new CorpusPrev { Speaker = speaker, Text = masked });
+            if (_prev.Count > PrevKept) _prev.RemoveAt(0);
+
+            return masked;
+        }
+
+        // ------------------------------------------------------------------ helpers
+
+        private static string Speaker(PlayerControl sender)
+        {
+            if (sender == PlayerControl.LocalPlayer) return "me";
+            if (!_speakers.TryGetValue(sender.PlayerId, out var name)) _speakers[sender.PlayerId] = name = "S" + (_speakers.Count + 1);
+            return name;
+        }
+
+        // The built-in list always applies; the file only ADDS to it, so an emptied file never weakens the filter.
+        private static ChatSafetyFilter Filter => _filter ??= LoadFilter();
+
+        private static ChatSafetyFilter LoadFilter()
+        {
+            var lines = new List<string>(ChatSafetyFilter.DefaultFile.Split('\n'));
+
+            try
+            {
+                var path = BlocklistFile;
+                if (!File.Exists(path)) File.WriteAllText(path, ChatSafetyFilter.DefaultFile);
+                else lines.AddRange(File.ReadAllLines(path));
+            }
+            catch (Exception e)
+            {
+                LogManager.LogError($"[Corpus] could not read the blocklist, using the built-in one: {e.Message}");
+            }
+
+            return ChatSafetyFilter.Parse(lines);
+        }
+
+        private static void Append(string path, string line)
+        {
+            try
+            {
+                lock (FileLock) File.AppendAllText(path, line + "\n");
+            }
+            catch (Exception e)
+            {
+                LogManager.LogError($"[Corpus] could not write {path}: {e.Message}");
+            }
+        }
+
+        private static float Round1(float v) => (float)Math.Round(v, 1);
+    }
+}
diff --git a/AMG/AI/Services/ChatService/Corpus/ChatRedactor.cs b/AMG/AI/Services/ChatService/Corpus/ChatRedactor.cs
new file mode 100644
index 0000000..cf90dd0
--- /dev/null
+++ b/AMG/AI/Services/ChatService/Corpus/ChatRedactor.cs
@@ -0,0 +1,28 @@
+using System.Text.RegularExpressions;
+
+namespace AMG.AI.Services.ChatService.Corpus
+{
+    /// <summary>Spots personal contact data in a message (links, handles, e-mails, phone-like numbers, "add me on discord").</summary>
+    public static class ChatRedactor
+    {
+        private static readonly Regex[] Contact =
+        [
+            new(@"(https?://|www\.)\S+", RegexOptions.IgnoreCase | RegexOptions.Compiled),
+            new(@"\b[\w-]+\.(com|net|org|gg|tv|io|me|co|xyz|ly|app|br)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled),
+            new(@"\S+@\S+\.\S+", RegexOptions.Compiled),
+            new(@"(^|\s)@\w{2,}", RegexOptions.Compiled),
+            new(@"\w+#\d{3,}", RegexOptions.Compiled),
+            new(@"\d{6,}", RegexOptions.Compiled),
+            new(@"\+?\d[\d\s().-]{8,}\d", RegexOptions.Compiled),
+            new(@"\b(discord|whatsapp|zap|telegram|snap(chat)?|insta(gram)?|tiktok|twitch|youtube)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled),
+        ];
+
+        public static bool HasContactInfo(string text)
+        {
+            if (string.IsNullOrWhiteSpace(text)) return false;
+            foreach (var r in Contact)
+                if (r.IsMatch(text)) return true;
+            return false;
+        }
+    }
+}
diff --git a/AMG/AI/Services/ChatService/Corpus/ChatSafetyFilter.cs b/AMG/AI/Services/ChatService/Corpus/ChatSafetyFilter.cs
new file mode 100644
index 0000000..bd70684
--- /dev/null
+++ b/AMG/AI/Services/ChatService/Corpus/ChatSafetyFilter.cs
@@ -0,0 +1,196 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text;
+
+namespace AMG.AI.Services.ChatService.Corpus
+{
+    public sealed class SafetyVerdict
+    {
+        public static readonly SafetyVerdict Clean = new();
+
+        public string Category;   // null = clean
+        public bool Drop;         // true = the text must not be stored or logged anywhere
+    }
+
+    /// <summary>
+    /// First line of defence of the corpus: messages that match the blocklist are NEVER stored (only their category is counted).
+    /// The second line is human review before anything reaches the bank (PhraseSourceEnum.Ai is never loaded at runtime).
+    ///
+    /// It judges MESSAGES, not players: nothing here is attached to a player, and nothing here feeds suspicion/trust.
+    /// A blocklist is crude by nature (euphemisms, other languages, creative spelling get through): keep it growing.
+    ///
+    /// File format (ChatBlocklist.txt): "[category]" headers, one term per line, "#" comments.
+    ///   - matched against WHOLE words, so "Essex" or "cocktail" never trigger "sex"/"cock"
+    ///   - a trailing "*" matches any word that starts with the term ("sex*" -> sexy, sexual)
+    ///   - several words = a phrase ("kill yourself")
+    ///   - leetspeak (s3x), repeated letters (seeex) and spaced letters (s e x) are folded before matching
+    ///   - category "profanity" is only flagged, every other category is dropped
+    /// </summary>
+    public sealed class ChatSafetyFilter
+    {
+        public const string DefaultFile =
+@"# AMG chat corpus blocklist.
+# Messages containing any of these (whole words, after folding leetspeak / repeated letters / spaced letters) are NOT stored:
+# only the category is counted. 'profanity' is just flagged, everything else is dropped.
+# This list is a starter. It WILL miss things (euphemisms, other languages): add what you see in your lobbies.
+
+[sexual]
+sex*
+porn*
+nude*
+nsfw
+dick
+cock
+pussy
+penis
+vagina
+boob*
+tits
+cum
+anal
+blowjob
+handjob
+horny
+masturbat*
+orgasm*
+sexo
+buceta
+
+[harassment]
+rape*
+kys
+kill yourself
+
+[hate]
+# add slurs here, one per line. Not shipped on purpose.
+
+[profanity]
+fuck*
+shit*
+bitch*
+porra
+caralho
+";
+
+        private const string FlagOnly = "profanity";
+
+        private readonly Dictionary<string, string> _exact = [];                          // skeleton -> category
+        private readonly List<(string prefix, string category)> _prefixes = [];
+        private readonly List<(string[] words, string category)> _phrases = [];
+
+        public static ChatSafetyFilter Parse(IEnumerable<string> lines)
+        {
+            var f = new ChatSafetyFilter();
+            string category = "other";
+
+            foreach (var raw in lines)
+            {
+                var line = raw.Trim();
+                if (line.Length == 0 || line[0] == '#') continue;
+
+                if (line[0] == '[' && line[^1] == ']') { category = line[1..^1].Trim().ToLowerInvariant(); continue; }
+
+                bool prefix = line.EndsWith('*');
+                var words = Tokens(Fold(prefix ? line[..^1] : line)).Select(Skeleton).Where(w => w.Length > 0).ToArray();
+                if (words.Length == 0) continue;
+
+                if (words.Length > 1) f._phrases.Add((words, category));
+                else if (prefix) f._prefixes.Add((words[0], category));
+                else f._exact[words[0]] = category;
+            }
+
+            return f;
+        }
+
+        public SafetyVerdict Check(string text)
+        {
+            if (string.IsNullOrWhiteSpace(text)) return SafetyVerdict.Clean;
+
+            var tokens = JoinSpacedLetters(Tokens(Fold(text))).Select(Skeleton).Where(t => t.Length > 0).ToList();
+            string found = null;
+
+            void Hit(string category)
+            {
+                // the worst category wins: a dropped one beats a merely flagged one
+                if (found == null || (found == FlagOnly && category != FlagOnly)) found = category;
+            }
+
+            foreach (var t in tokens)
+            {
+                if (_exact.TryGetValue(t, out var c)) Hit(c);
+                foreach (var (prefix, category) in _prefixes)
+                    if (t.StartsWith(prefix, StringComparison.Ordinal)) Hit(category);
+            }
+
+            foreach (var (words, category) in _phrases)
+            {
+                for (int i = 0; i + words.Length <= tokens.Count; i++)
+                {
+                    bool all = true;
+                    for (int j = 0; j < words.Length && all; j++) all = tokens[i + j] == words[j];
+                    if (all) { Hit(category); break; }
+                }
+            }
+
+            return found == null ? SafetyVerdict.Clean : new SafetyVerdict { Category = found, Drop = found != FlagOnly };
+        }
+
+        // ------------------------------------------------------------------ folding
+
+        /// <summary>Lowercase, no accents, leetspeak to letters.</summary>
+        private static string Fold(string s)
+        {
+            var sb = new StringBuilder(s.Length);
+            foreach (char c0 in s.ToLowerInvariant().Normalize(NormalizationForm.FormD))
+            {
+                if (CharUnicodeInfo.GetUnicodeCategory(c0) == UnicodeCategory.NonSpacingMark) continue;
+                sb.Append(c0 switch
+                {
+                    '0' => 'o', '1' => 'i', '3' => 'e', '4' => 'a', '5' => 's', '7' => 't',
+                    '@' => 'a', '$' => 's', '!' => 'i', '|' => 'i', '+' => 't',
+                    _ => c0,
+                });
+            }
+            return sb.ToString();
+        }
+
+        private static List<string> Tokens(string folded)
+        {
+            var list = new List<string>();
+            var cur = new StringBuilder();
+            foreach (char c in folded)
+            {
+                if (char.IsLetter(c)) cur.Append(c);
+                else if (cur.Length > 0) { list.Add(cur.ToString()); cur.Clear(); }
+            }
+            if (cur.Length > 0) list.Add(cur.ToString());
+            return list;
+        }
+
+        /// <summary>"s e x" / "s.e.x" -> "sex" (three or more single letters in a row).</summary>
+        private static List<string> JoinSpacedLetters(List<string> tokens)
+        {
+            var result = new List<string>();
+            for (int i = 0; i < tokens.Count;)
+            {
+                int j = i;
+                while (j < tokens.Count && tokens[j].Length == 1) j++;
+
+                if (j - i >= 3) { result.Add(string.Concat(tokens.Skip(i).Take(j - i))); i = j; }
+                else { result.Add(tokens[i]); i++; }
+            }
+            return result;
+        }
+
+        /// <summary>"seeex" and "sex" compare equal: repeated letters collapse to one.</summary>
+        private static string Skeleton(string s)
+        {
+            var sb = new StringBuilder(s.Length);
+            foreach (char c in s)
+                if (sb.Length == 0 || sb[^1] != c) sb.Append(c);
+            return sb.ToString();
+        }
+    }
+}
