diff --git a/AMG/KeyDownActions/CorpusKeys.cs b/AMG/KeyDownActions/CorpusKeys.cs
new file mode 100644
index 0000000..5d17b1a
--- /dev/null
+++ b/AMG/KeyDownActions/CorpusKeys.cs
@@ -0,0 +1,33 @@
+using AMG.AI.Services.ChatService.Corpus;
+using AMG.Utilities.KeyDown;
+using UnityEngine;
+
+namespace AMG.KeyDownActions
+{
+    // Chat corpus: the mod cannot see everything a player reacts to (a phantom vanishing, a joke about it...),
+    // but YOU can. Press the key when you see it; the next meeting's messages carry that event as context.
+
+    [KeyPressManager.Register(KeyCode.F9)]
+    public static class CorpusToggleKey
+    {
+        public static void Execute() => ChatCorpus.Toggle();
+    }
+
+    [KeyPressManager.Register(KeyCode.F6)]
+    public static class CorpusMarkPhantomKey
+    {
+        public static void Execute() => ChatCorpus.Mark("phantom_vanish");
+    }
+
+    [KeyPressManager.Register(KeyCode.F7)]
+    public static class CorpusMarkKillKey
+    {
+        public static void Execute() => ChatCorpus.Mark("kill_seen");
+    }
+
+    [KeyPressManager.Register(KeyCode.F8)]
+    public static class CorpusMarkVentKey
+    {
+        public static void Execute() => ChatCorpus.Mark("vent_seen");
+    }
+}
